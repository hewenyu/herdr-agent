<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Render with deploy/install.sh. LaunchAgents start at GUI login, not at boot.
     herdr retains ownership of Claude/Codex processes. This service only schedules.
     Credentials stay in the private state directory; log files need external rotation. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hewenyu.myrix</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MYRIX_BIN__</string>
    <string>serve</string>
    <string>--state-dir</string>
    <string>__STATE_DIR__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- State locking excludes duplicate connections. Missing authorization keeps
       the local Web available; unrecoverable failures retry at a bounded rate. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__STATE_DIR__/log/myrix.out.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE_DIR__/log/myrix.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__CLEAN_PATH__</string>
  </dict>
</dict>
</plist>
